---
/**
 * TagCard.astro · 侧栏标签云
 * 标签用浅色胶囊承载，悬停染上对应的主色浅色版本。
 */
import { sidebar } from '@/config';
import { accentByIndex } from '@/lib/accent';
import { tagHref, type FacetItem } from '@/lib/posts';
import Icon from '@/components/common/Icon.astro';

interface Props {
  items: FacetItem[];
}

const { items } = Astro.props;
const shown = items.slice(0, sidebar.tagsLimit);
---

{
  shown.length > 0 && (
    <section class="card card-pad tag-card" aria-label="标签">
      <header class="head">
        <Icon name="lucide:tags" size={14} />
        <h2>标签</h2>
        <a class="more" href="/tags/">
          全部
          <Icon name="lucide:chevron-right" size={12} />
        </a>
      </header>

      <ul>
        {shown.map((item, i) => (
          <li data-accent={accentByIndex(i)}>
            <a href={tagHref(item.name)}>
              <span class="hash">#</span>
              {item.name}
              <span class="count">{item.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .tag-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text-3);
  }

  .head h2 {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .more {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-mono);
    color: var(--text-3);
    transition: color var(--t-color);
  }

  .more:hover {
    color: var(--a-d);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 4px 10px;
    border-radius: var(--r-pill);
    background: var(--bg-soft);
    color: var(--text-2);
    font-size: var(--fs-meta);
    line-height: 1.7;
    transition: background-color var(--t-color), color var(--t-color),
      transform var(--t-move);
  }

  a:hover {
    background: var(--a-l);
    color: var(--a-d);
    transform: translateY(-2px);
  }

  .hash {
    font-family: var(--font-mono);
    color: var(--a-d);
    opacity: 0.8;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text-3);
    letter-spacing: var(--ls-mono);
  }

  a:hover .count {
    color: var(--a-d);
  }
</style>
