---
/**
 * BaseLayout.astro · 全站外壳
 * ----------------------------------------------------------------------------
 * 负责：<head> 元信息、主题初始化（避免闪白）、固定导航栏、移动端抽屉、
 *       页脚，以及所有全局岛屿（进度条 / 搜索 / 灯箱 / 回到顶部 / 正文增强）。
 */
import '@/styles/app.css';
import { ClientRouter } from 'astro:transitions';
import { site, banner as bannerConf } from '@/config';
import Navbar from '@/components/layout/Navbar.astro';
import MobileDrawer from '@/components/layout/MobileDrawer.astro';
import SiteFooter from '@/components/layout/Footer.astro';
import ReadingProgress from '@/components/svelte/ReadingProgress.svelte';
import BackToTop from '@/components/svelte/BackToTop.svelte';
import SearchModal from '@/components/svelte/SearchModal.svelte';
import Lightbox from '@/components/svelte/Lightbox.svelte';
import HeaderBehavior from '@/components/svelte/HeaderBehavior.svelte';
import ProseEnhance from '@/components/svelte/ProseEnhance.svelte';
import Reveal from '@/components/svelte/Reveal.svelte';
import ImageFade from '@/components/svelte/ImageFade.svelte';

interface Props {
  /** 页面标题；不传则只用站点标题 */
  title?: string;
  description?: string;
  /** 社交卡片图，默认 /og.png */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** 本页是否自带 Banner（决定导航栏是浮层还是实心） */
  hasBanner?: boolean;
  /** 本页是否包含 .prose 正文，需要代码块 / 表格 / 外链增强 */
  prose?: boolean;
  /** 文章发布时间，供 og:article 使用 */
  publishedTime?: Date;
  updatedTime?: Date;
}

const {
  title,
  description = site.description,
  image = '/og.png',
  type = 'website',
  noindex = false,
  hasBanner = false,
  prose = false,
  publishedTime,
  updatedTime,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.title}` : `${site.title} · ${site.subtitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? `https://${Astro.url.host}`);
const ogImage = new URL(image, Astro.site ?? `https://${Astro.url.host}`);
const bannerOn = hasBanner && bannerConf.enabled;
---

<!doctype html>
<!--
  页面跳转用 Astro 的 ClientRouter（View Transitions）：
  各个全局岛屿（Svelte 组件）都标了 transition:persist，切页时保留，只有主内容
  重新渲染 —— 所以切页不会闪、也不会重新下载脚本。

  注意：transition:persist 只对「HTML 元素」和「群岛」生效。导航栏 / 抽屉是普通
  Astro 组件，指令不会被转成属性，它们每页重新 SSR —— 这是刻意的，因为导航栏的
  data-transparent 要随页面（首页有 Banner 才是浮层）变，跨页保留反而会串味。
  为此 HeaderBehavior 每次导航后都会重新解析 DOM 引用，见该文件。

  整页的默认交叉淡入关掉了（transition:animate="none"）：
  主内容自己有一段 page-enter 上浮动画，两者叠加会显得糊。
-->
<html lang={site.lang} data-theme-mode="auto" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      主题初始化：必须同步执行且早于首次绘制，否则会出现亮色闪一下再变暗。
      三态约定：localStorage 无值 = 跟随系统。
      顺便挂上 html.js —— 动效层只在 JS 可用时才把元素设为初始隐藏，
      这样关掉 JavaScript 的读者看到的仍是完整页面。

      为什么要把 applyTheme 挂到 window 上：View Transitions 换页时
      Astro 会把 <html> 的属性全部删光再套用新文档的（见 swapRootAttributes），
      而 SSR 输出的 <html> 里没有 dark / js —— 不补的话每次换页都会掉回亮色。
      ThemeToggle 复用同一个函数，保证「页头脚本」和「切换按钮」永远一致。
    -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');

        /** 读用户的手动选择；没选过返回 null（= 跟随系统） */
        function storedMode() {
          try {
            var v = localStorage.getItem('theme');
            return v === 'light' || v === 'dark' ? v : null;
          } catch (e) {
            return null; // localStorage 被禁用时按「跟随系统」处理
          }
        }

        /** 把模式渲染到 <html> 上。mode: 'light' | 'dark' | 'auto' */
        function applyTheme(mode) {
          var dark =
            mode === 'dark' ||
            (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);

          root.classList.toggle('dark', dark);
          root.dataset.themeMode = mode;

          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#141110' : '#ffffff');
        }

        window.__theme = {
          mode: function () {
            return storedMode() || 'auto';
          },
          apply: applyTheme,
        };

        applyTheme(window.__theme.mode());

        if (!window.__themeBound) {
          window.__themeBound = true;

          /*
           * 换页后立刻补回被抹掉的状态。
           * astro:after-swap 在 DOM 替换完成、绘制之前触发，正是官方推荐
           * 处理「换页后要保持的状态」（比如暗色模式）的时机。
           */
          document.addEventListener('astro:after-swap', function () {
            root.classList.add('js');
            applyTheme(window.__theme.mode());
          });

          // 系统主题变化时跟随 —— 但用户手动选过就尊重用户的选择
          window
            .matchMedia('(prefers-color-scheme: dark)')
            .addEventListener('change', function () {
              if (!storedMode()) applyTheme('auto');
            });
        }
      })();
    </script>
  </head>

  <body data-banner={bannerOn ? 'true' : 'false'}>
    <ClientRouter />
    <a class="skip-link" href="#main">跳到主要内容</a>

    <div class="site">
      <ReadingProgress client:load transition:persist />
      <Navbar transparent={bannerOn} />
      <MobileDrawer />

      <main id="main" class="site-main">
        <slot />
      </main>

      <SiteFooter />
    </div>

    <BackToTop client:idle transition:persist />
    <SearchModal client:idle transition:persist />
    <Lightbox client:idle transition:persist />
    <HeaderBehavior client:load transition:persist />
    {prose && <ProseEnhance client:idle />}
    <Reveal client:load />
    <ImageFade client:idle />
  </body>
</html>
