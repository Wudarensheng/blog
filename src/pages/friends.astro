---
/**
 * 友链
 */
import { friendApplication, friends, site } from '@/config';
import { accentByIndex } from '@/lib/accent';
import MainLayout from '@/layouts/MainLayout.astro';
import PageHeader from '@/components/common/PageHeader.astro';
import Dots from '@/components/common/Dots.astro';
import Icon from '@/components/common/Icon.astro';

const fields = friendApplication.fields;
---

<MainLayout title="友链" description="一路走来遇到的好站点。">
  <PageHeader
    title="友链"
    description="这里是一些我常读、常查、常抄作业的站点。排序没有规则，纯粹是想到哪个写哪个。"
    crumbs={[{ label: '首页', href: '/' }, { label: '友链' }]}
    accent="amber"
    count={friends.length}
  />

  <div class="grid">
    {
      friends.map((friend, i) => (
        <a
          class="friend card card-hover"
          data-accent={accentByIndex(i)}
          href={friend.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="avatar">
            <img src={friend.avatar} alt="" width="44" height="44" loading="lazy" />
          </span>

          <span class="text">
            <strong>
              {friend.name}
              <Icon name="lucide:external-link" size={12} class="ext" />
            </strong>
            <small>{friend.desc}</small>
          </span>

          <span class="corner"><Dots small /></span>
        </a>
      ))
    }
  </div>

  {
    friendApplication.enabled && (
      <section class="apply card card-pad" data-accent="clay" aria-label="申请友链">
        <header class="apply-head">
          <Dots small />
          <h2>{friendApplication.title}</h2>
        </header>

        <p class="intro">{friendApplication.intro}</p>

        <div class="cols">
          <div class="info">
            <h3>本站信息</h3>
            <dl>
              {fields.map((field, i) => (
                <div data-accent={accentByIndex(i)}>
                  <dt>{field.key}</dt>
                  <dd>{field.value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="reqs">
            <h3>一点点要求</h3>
            <ul>
              {friendApplication.requirements.map((item) => (
                <li>
                  <Icon name="lucide:check" size={13} />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <a class="btn apply-btn" href={`mailto:hi@${site.url.replace(/^https?:\/\//, '')}`}>
          <Icon name="lucide:mail" size={14} />
          发邮件申请
        </a>
      </section>
    )
  }
</MainLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--gap-card);
  }

  .friend {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-4);
    overflow: hidden;
  }

  .avatar {
    flex: none;
    padding: 2px;
    border-radius: 50%;
    /* 跟随每张卡片的 data-accent，三站轮转；不用全局的 --ring */
    background: var(--a);
    transition: transform var(--t-ring);
  }

  .friend:hover .avatar {
    transform: rotate(10deg) scale(1.04);
  }

  .avatar img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--card);
    object-fit: cover;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .text strong {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-1);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .text :global(.ext) {
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity var(--t-move), transform var(--t-move), color var(--t-color);
  }

  .friend:hover .text :global(.ext) {
    opacity: 1;
    transform: translateX(0);
    color: var(--a-d);
  }

  .text small {
    color: var(--text-3);
    font-size: var(--fs-meta);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .corner {
    position: absolute;
    top: 12px;
    right: 12px;
    opacity: 0.45;
    transition: opacity var(--t-move);
  }

  .friend:hover .corner {
    opacity: 1;
  }

  /* ------------------------------------------------------------- 申请区 --- */
  .apply {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .apply-head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .apply-head h2 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .intro {
    color: var(--text-2);
    font-size: 0.86rem;
    line-height: 1.8;
    max-width: 68ch;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--s-4);
  }

  .info,
  .reqs {
    padding: var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--bg-soft);
  }

  h3 {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: var(--s-3);
  }

  dl {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  dl div {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: var(--s-2);
    align-items: baseline;
  }

  dt {
    font-size: var(--fs-label);
    color: var(--a-d);
    font-weight: 700;
  }

  dd {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: var(--ls-mono);
    color: var(--text-2);
    overflow-wrap: anywhere;
  }

  .reqs ul {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .reqs li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: var(--text-2);
    font-size: var(--fs-meta);
    line-height: 1.7;
  }

  .reqs :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--amber-d);
  }

  .apply-btn {
    align-self: flex-start;
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .apply-btn {
      width: 100%;
    }
  }
</style>
